# Copy to .env and fill in. Never commit the real .env.

# Logins: "username:password" pairs, comma separated. Users are created on first start
# (changing a password later: Settings page in the app).
KUZE_USERS=kuze:change-this-password,partner:change-this-too

# Secret that signs login cookies. Generate one with:  openssl rand -hex 32
KUZE_JWT_SECRET=

# The Odds API key (https://the-odds-api.com). Optional but recommended: pulls Hard Rock Bet
# lines + the sharp consensus (Pinnacle, Circa, ...) every 30 minutes, and player props.
# Without it you type the Hard Rock numbers in by hand on each game page.
ODDS_API_KEY=

# Anthropic API key for the "AI analyst" tab (optional). It writes the master-prompt report
# from the model's numbers and verifies news (injuries, QB status, weather) with web search.
ANTHROPIC_API_KEY=
# KUZE_ANALYST_MODEL=claude-opus-5

# Background jobs: data refresh 4x/day, paper bets at kickoff, weekly learning loop. 1 = on.
KUZE_SCHEDULER=1

# Only needed when the frontend is served from a different origin (e.g. `npm run dev`).
# KUZE_CORS=http://localhost:5173

# Advanced
# KUZE_DATA_DIR=/data                 # nflverse cache, database, trained models
# KUZE_DB_URL=sqlite:////data/kuze.db # any SQLAlchemy URL (e.g. Postgres) instead of SQLite
# KUZE_BOOK_KEY=hardrockbet           # The Odds API bookmaker key treated as "your" book
# KUZE_LIVE_TTL_HOURS=6               # how long in-season nflverse files are trusted before re-download

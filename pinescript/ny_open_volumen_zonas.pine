//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  NY OPEN · VOLUMEN VS SESIONES ANTERIORES  +  ZONAS DE CIERRE HORARIO
//
//  1) Vela de apertura NY (09:30–09:35, 5 min)
//     · Dirección de la vela.
//     · Volumen de la vela vs la MEDIA de esa misma vela en las N sesiones previas.
//     · Lectura:
//         volumen ≥ media           → SIGUE la dirección de la vela
//         volumen muy por encima    → SIGUE · fuerte
//         volumen < media           → AMBIGUA / CONTRARIA
//     · ¿Caminó o no? (medido desde el CIERRE de la vela, 09:35)
//         SIGUE     = en el checkpoint el precio está más allá del cierre de la
//                     vela, a su favor (+ recorrido mínimo opcional)
//         CONTRARIA = en el checkpoint está al otro lado de la vela
//         AMBIGUA   = ni una cosa ni la otra
//
//  2) Zonas de cierre horario
//     Rango del precio desde 5 min antes hasta 5 min después de cada cierre de
//     vela de 1H (10:55–11:05 para la vela que cierra a las 11:00), con línea en
//     el precio exacto del cierre, extendida a la derecha.
//
//  Gráfico de 5m (o 1m). Para el volumen usa un símbolo con volumen real:
//  CME_MINI:NQ1! o CME_MINI:MNQ1!
// ═══════════════════════════════════════════════════════════════════════════
indicator("NY Open Volumen + Zonas de cierre horario", shorttitle = "NYO Vol + Zonas 1H", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────── 1 · Vela de apertura ───────────────────────────
G1 = "1 · Vela de apertura NY"
showOpen = input.bool(true, "Activar", group = G1)
tzIn     = input.string("America/New_York", "Zona horaria", group = G1)
openH    = input.int(9, "Hora", minval = 0, maxval = 23, inline = "t", group = G1)
openM    = input.int(30, "Min", minval = 0, maxval = 59, inline = "t", group = G1)
openLen  = input.int(5, "Duración de la vela (min)", minval = 1, maxval = 60, group = G1)

// ─────────────────────────── 2 · Volumen ───────────────────────────
G2 = "2 · Volumen vs sesiones anteriores"
lookback = input.int(20, "Sesiones anteriores", minval = 3, maxval = 250, group = G2)
baseType = input.string("Media", "Comparar contra", options = ["Media", "Mediana"], group = G2)
strongPc = input.float(50.0, "Muy alto si supera la base en +%", minval = 0.0, step = 5.0, group = G2)
lowRV    = input.float(1.0, "Bajo la media si RVOL <", minval = 0.1, step = 0.05, group = G2, tooltip = "RVOL = volumen de hoy / base. 1.0 = justo en la media.")

// ─────────────────────────── 3 · Seguimiento ───────────────────────────
G3 = "3 · ¿Camina o no?"
cp1     = input.int(60, "Checkpoint 1 (min desde la apertura)", minval = 5, maxval = 1440, group = G3, tooltip = "60 = 10:30 NY")
cp2     = input.int(390, "Checkpoint 2 (min desde la apertura)", minval = 5, maxval = 1440, group = G3, tooltip = "390 = 16:00 NY")
minMove = input.float(0.0, "Recorrido mínimo para SIGUE (x rango de la vela)", minval = 0.0, step = 0.25, group = G3, tooltip = "0 = basta con estar más allá del cierre de la vela. 0.5 = tiene que haber caminado al menos media vela.")
showRes = input.bool(true, "Etiqueta de resultado en el checkpoint 2", group = G3)
minN    = input.int(20, "N mínimo para colorear los %", minval = 1, group = G3)

// ─────────────────────────── 4 · Visual apertura ───────────────────────────
G4 = "4 · Visual apertura"
showBox  = input.bool(true, "Caja de la vela", group = G4)
showLbl  = input.bool(true, "Etiqueta", group = G4)
colorBar = input.bool(true, "Colorear la vela de apertura", group = G4)
showHoy  = input.bool(true, "Tabla de hoy", inline = "p1", group = G4)
posHoyIn = input.string("Arriba derecha", "", options = ["Arriba derecha", "Abajo derecha", "Arriba izquierda", "Abajo izquierda"], inline = "p1", group = G4)
showHis  = input.bool(true, "Tabla histórica", inline = "p2", group = G4)
posHisIn = input.string("Abajo derecha", "", options = ["Arriba derecha", "Abajo derecha", "Arriba izquierda", "Abajo izquierda"], inline = "p2", group = G4)
cUp      = input.color(#26a69a, "Sigue ▲", inline = "c", group = G4)
cDn      = input.color(#ef5350, "Sigue ▼", inline = "c", group = G4)
cAmb     = input.color(#9e9e9e, "Ambigua", inline = "c", group = G4)

// ─────────────────────────── 5 · Zonas de cierre horario ───────────────────────────
G5 = "5 · Zonas de cierre horario"
showZ    = input.bool(true, "Activar", group = G5)
zPreMin  = input.int(5, "Min antes", minval = 1, maxval = 25, inline = "z1", group = G5)
zPostMin = input.int(5, "Min después", minval = 1, maxval = 25, inline = "z1", group = G5)
zAllH    = input.bool(false, "Todas las horas (24h)", group = G5)
zFromH   = input.int(10, "Cierres desde las", minval = 0, maxval = 23, inline = "z2", group = G5)
zToH     = input.int(16, "hasta las", minval = 0, maxval = 23, inline = "z2", group = G5, tooltip = "Hora NY del cierre de la vela de 1H. 10 → zona 09:55–10:05 · 16 → 15:55–16:05")
zHeight  = input.string("Máx–Mín", "Altura de la zona", options = ["Máx–Mín", "Cuerpos"], group = G5)
zExt     = input.string("Hasta que el precio la cruce", "Extender", options = ["Hasta que el precio la cruce", "Horas fijas", "Siempre"], group = G5, tooltip = "Cruzar = cerrar al otro lado de la zona después de haber estado del lado contrario.")
zExtH    = input.int(4, "Horas (modo 'Horas fijas')", minval = 1, maxval = 500, group = G5)
zMax     = input.int(15, "Zonas visibles (máx.)", minval = 1, maxval = 200, group = G5)
zShift   = input.int(0, "Desplazar zona (min)", minval = -25, maxval = 25, group = G5, tooltip = "0 = centrada en el cierre horario. Pon -10 o +10 para ver zonas que NO están en el cierre de la hora y comparar cómo reacciona el precio.")
zShowPx  = input.bool(true, "Línea en el precio del cierre", group = G5)
zShowTxt = input.bool(true, "Texto: hora y toques", group = G5)
zCol     = input.color(#b388ff33, "Zona", inline = "zc", group = G5)
zColLn   = input.color(#b388ff, "Borde/línea", inline = "zc", group = G5)
zColX    = input.color(#787b861a, "Cruzada", inline = "zc", group = G5)

// ─────────────────────────── Constantes ───────────────────────────
color RES_OK   = #00c853
color RES_BAD  = #ff5252
color RES_AMB  = #9e9e9e
float strongRV = 1.0 + strongPc / 100.0
int   needG    = math.max(3, math.round(lookback / 2))

// ─────────────────────────── Validación de timeframe ───────────────────────────
int tfSec = timeframe.in_seconds()
if not timeframe.isintraday
    runtime.error("Usa un gráfico intradía (ideal: 5 minutos).")
if showOpen and (tfSec > openLen * 60 or (openLen * 60) % tfSec != 0)
    runtime.error("La vela de apertura necesita un gráfico de 1m o 5m.")
if showZ and tfSec > 300
    runtime.error("Las zonas de cierre horario necesitan un gráfico de 5m o menor.")

// ─────────────────────────── Tipos ───────────────────────────
type Bucket
    int n = 0
    int sig1 = 0
    int sig2 = 0
    int amb2 = 0
    int con2 = 0
    array<float> mv

type Track
    bool  active = false
    int   bk = -1
    int   dir = 0
    float ref = na
    float hi = na
    float lo = na
    float rng = na
    int   end1 = 0
    int   end2 = 0
    int   startBar = 0
    float c1 = na
    float c2 = na
    int   t2 = 0

type Zone
    box   bx
    line  ln
    int   key
    float top
    float bot
    int   endT
    int   stopT
    bool  done = false
    bool  live = true
    int   side = 0
    bool  inside = true
    int   touches = 0

// ─────────────────────────── Funciones ───────────────────────────
// Cierra la medición de una sesión: ¿siguió, ambigua o contraria?
method settle(Track t, array<Bucket> bks, bool drawLbl) =>
    if t.bk >= 0 and t.dir != 0 and not na(t.c2)
        Bucket b = bks.get(t.bk)
        float need = minMove * t.rng
        b.n := b.n + 1
        if not na(t.c1) and (t.c1 - t.ref) * t.dir > need
            b.sig1 := b.sig1 + 1
        float mv     = (t.c2 - t.ref) * t.dir
        bool  sigue  = mv > need
        bool  contra = not sigue and (t.dir > 0 ? t.c2 < t.lo : t.c2 > t.hi)
        if sigue
            b.sig2 := b.sig2 + 1
        else if contra
            b.con2 := b.con2 + 1
        else
            b.amb2 := b.amb2 + 1
        if t.rng > 0
            b.mv.push(mv / t.rng)
        if drawLbl and t.rng > 0
            string rt = (sigue ? "✔ siguió " : contra ? "✖ contraria " : "≈ ambigua ") + (mv >= 0 ? "+" : "") + str.tostring(mv / t.rng, "0.0") + "x"
            color  rc = sigue ? RES_OK : contra ? RES_BAD : RES_AMB
            label.new(t.t2, t.c2, rt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(rc, 20), textcolor = color.white, size = size.tiny)
    t.active := false

// Lectura según la hipótesis: volumen sobre la media → sigue; bajo la media → ambigua/contraria
fReading(float rv, int dir, int hs, int need, bool hv) =>
    string r = ""
    if dir == 0
        r := "SIN DIRECCIÓN"
    else if not hv
        r := "SIN VOLUMEN"
    else if na(rv)
        r := "calentando " + str.tostring(hs) + "/" + str.tostring(need)
    else if rv >= strongRV
        r := (dir > 0 ? "SIGUE ▲" : "SIGUE ▼") + " · fuerte"
    else if rv >= lowRV
        r := dir > 0 ? "SIGUE ▲" : "SIGUE ▼"
    else
        r := "AMBIGUA / CONTRARIA"
    r

fHourOk(int anchor) =>
    int h = hour(anchor - zShift * 60000, tzIn)
    bool inRange = zFromH <= zToH ? (h >= zFromH and h <= zToH) : (h >= zFromH or h <= zToH)
    zAllH or inRange

fZoneTxt(int key, int touches) =>
    string s = str.format_time(key - zShift * 60000, "HH:mm", tzIn)
    touches > 0 ? s + " · " + str.tostring(touches) + (touches == 1 ? " toque" : " toques") : s

fPos(string p) =>
    switch p
        "Abajo derecha"    => position.bottom_right
        "Arriba izquierda" => position.top_left
        "Abajo izquierda"  => position.bottom_left
        => position.top_right

fHM(int mins) =>
    int tot = openH * 60 + openM + mins
    int h   = math.floor(tot / 60) % 24
    int m   = tot % 60
    (h < 10 ? "0" : "") + str.tostring(h) + ":" + (m < 10 ? "0" : "") + str.tostring(m)

fPct(int k, int n) =>
    n > 0 ? str.tostring(100.0 * k / n, "0") + "%" : "—"

fPctBg(int k, int n, bool higherIsGood) =>
    color res = color.new(#131722, 5)
    if n >= minN
        float p = 100.0 * k / n
        res := higherIsGood ? color.from_gradient(p, 40, 65, color.new(#ef5350, 35), color.new(#26a69a, 35)) : color.from_gradient(p, 20, 45, color.new(#26a69a, 35), color.new(#ef5350, 35))
    res

fSigned(float x) =>
    na(x) ? "—" : (x >= 0 ? "+" : "") + str.tostring(x, "0.00") + "x"

fCell(table tb, int c, int r, string s, color bg, color fg, string tip = "") =>
    table.cell(tb, c, r, s, text_color = fg, bgcolor = bg, text_size = size.small, tooltip = tip)

// ═══════════════════════════ 1 · APERTURA NY ═══════════════════════════
int  yy       = year(time, tzIn)
int  mo       = month(time, tzIn)
int  dd       = dayofmonth(time, tzIn)
int  winS     = timestamp(tzIn, yy, mo, dd, openH, openM, 0)
int  winE     = winS + openLen * 60000
bool inWin    = time >= winS and time < winE
bool winFirst = inWin and not inWin[1]
bool winLast  = inWin and time_close >= winE

var bool hasVol = false
if not na(volume) and volume > 0
    hasVol := true

var array<float>  vHist = array.new<float>()
var array<Bucket> stats = array.new<Bucket>()
if stats.size() == 0
    for i = 0 to 2
        stats.push(Bucket.new(mv = array.new<float>()))
var Track trk = Track.new()

// Seguimiento de la sesión en curso (solo con velas cerradas)
if showOpen and trk.active and barstate.isconfirmed and bar_index > trk.startBar
    if time >= trk.end2 or winFirst
        trk.settle(stats, showRes)
    else
        if time_close <= trk.end1
            trk.c1 := close
        if time_close <= trk.end2
            trk.c2 := close
            trk.t2 := time
        if time_close >= trk.end2
            trk.settle(stats, showRes)

// Construcción de la vela de apertura (1m o 5m)
var float cO = na
var float cH = na
var float cL = na
var float cC = na
var float cV = 0.0
if winFirst
    cO := open
    cH := high
    cL := low
    cV := 0.0
if inWin
    cH := math.max(cH, high)
    cL := math.min(cL, low)
    cC := close
    cV += nz(volume)

// Valores de hoy (para la tabla)
var float tVol  = na
var float tBase = na
var float tRV   = na
var float tZ    = na
var float tPct  = na
var int   tDir  = 0
var float tRef  = na
var float tHi   = na
var float tLo   = na
var float tRng  = na
var int   tWin  = 0
var int   tHs   = 0

bool  sigUp  = false
bool  sigDn  = false
bool  sigAmb = false
color bc     = na

// Vela terminada → leer volumen y dirección
if showOpen and winLast and barstate.isconfirmed
    float rng  = cH - cL
    int   dir  = cC > cO ? 1 : cC < cO ? -1 : 0
    int   hs   = vHist.size()
    float base = na
    float zs   = na
    float pctl = na
    if hasVol and hs >= needG
        base := baseType == "Media" ? vHist.avg() : vHist.median()
        float sd = vHist.stdev()
        zs := sd > 0 ? (cV - vHist.avg()) / sd : na
        int below = 0
        for v in vHist
            if v < cV
                below += 1
        pctl := 100.0 * below / hs
    float  rv      = not na(base) and base > 0 ? cV / base : na
    int    bk      = na(rv) or dir == 0 ? -1 : rv >= strongRV ? 0 : rv >= lowRV ? 1 : 2
    bool   strong  = bk == 0
    string reading = fReading(rv, dir, hs, needG, hasVol)
    color  col     = dir == 0 or na(rv) ? cAmb : rv < lowRV ? cAmb : dir > 0 ? cUp : cDn

    // la vela de hoy entra al histórico después de compararla
    vHist.push(cV)
    while vHist.size() > lookback
        vHist.shift()

    // arrancar el seguimiento
    trk.active   := bk >= 0
    trk.bk       := bk
    trk.dir      := dir
    trk.ref      := cC
    trk.hi       := cH
    trk.lo       := cL
    trk.rng      := rng
    trk.end1     := winS + math.min(cp1, cp2) * 60000
    trk.end2     := winS + math.max(cp1, cp2) * 60000
    trk.startBar := bar_index
    trk.c1       := na
    trk.c2       := na
    trk.t2       := time

    tVol  := cV
    tBase := base
    tRV   := rv
    tZ    := zs
    tPct  := pctl
    tDir  := dir
    tRef  := cC
    tHi   := cH
    tLo   := cL
    tRng  := rng
    tWin  := winS
    tHs   := hs

    sigUp  := (bk == 0 or bk == 1) and dir > 0
    sigDn  := (bk == 0 or bk == 1) and dir < 0
    sigAmb := bk == 2
    bc     := colorBar ? (strong ? col : color.new(col, 35)) : na

    if showBox
        box.new(winS, cH, winS + math.max(cp1, cp2) * 60000, cL, xloc = xloc.bar_time, border_color = col, border_width = strong ? 2 : 1, bgcolor = color.new(col, strong ? 78 : 88))
    if showLbl
        string vTxt = na(rv) ? "Vol " + str.tostring(cV, format.volume) : "Vol " + (rv >= 1 ? "+" : "") + str.tostring((rv - 1) * 100, "0") + "% vs " + str.lower(baseType) + (na(pctl) ? "" : " · p" + str.tostring(pctl, "0"))
        string txt  = reading + "\n" + (dir > 0 ? "Vela ▲ · " : dir < 0 ? "Vela ▼ · " : "Vela ◆ · ") + vTxt
        if bk >= 0
            Bucket hb = stats.get(bk)
            if hb.n >= 5
                txt += "\nHist.: siguió " + str.tostring(100.0 * hb.sig2 / hb.n, "0") + "% · contraria " + str.tostring(100.0 * hb.con2 / hb.n, "0") + "% (n=" + str.tostring(hb.n) + ")"
        label.new(winS, dir < 0 ? cL : cH, txt, xloc = xloc.bar_time, style = dir < 0 ? label.style_label_up : label.style_label_down, color = color.new(col, 10), textcolor = color.white, size = size.small)
    if not na(rv) and dir != 0
        alert(syminfo.ticker + " · apertura NY: " + reading + " · RVOL " + str.tostring(rv, "0.00") + "x", alert.freq_once_per_bar_close)

barcolor(bc)
plotshape(sigUp, "Sigue ▲", shape.triangleup, location.belowbar, cUp, size = size.tiny)
plotshape(sigDn, "Sigue ▼", shape.triangledown, location.abovebar, cDn, size = size.tiny)
plotshape(sigAmb, "Ambigua / contraria", shape.diamond, location.abovebar, cAmb, size = size.tiny)
alertcondition(sigUp, "Apertura: SIGUE ▲", "Vela de apertura alcista con volumen sobre la media")
alertcondition(sigDn, "Apertura: SIGUE ▼", "Vela de apertura bajista con volumen sobre la media")
alertcondition(sigAmb, "Apertura: AMBIGUA / CONTRARIA", "Vela de apertura con volumen bajo la media")

// ═══════════════════════════ 2 · ZONAS DE CIERRE HORARIO ═══════════════════════════
var array<Zone> zones = array.new<Zone>()
int   hO     = time("60")
int   shMs   = zShift * 60000
int   aCur   = na(hO) ? 0 : hO + shMs
int   aNext  = na(hO) ? 0 : hO + 3600000 + shMs
bool  inNext = aNext > 0 and time < aNext + zPostMin * 60000 and time_close > aNext - zPreMin * 60000
bool  inCur  = aCur > 0 and time < aCur + zPostMin * 60000 and time_close > aCur - zPreMin * 60000
int   aKey   = inNext ? aNext : inCur ? aCur : 0
float zHiV   = zHeight == "Cuerpos" ? math.max(open, close) : high
float zLoV   = zHeight == "Cuerpos" ? math.min(open, close) : low

if showZ
    // Crear la zona (minutos antes del cierre) o ampliarla (antes y después)
    if aKey > 0 and fHourOk(aKey)
        Zone lz = na
        if zones.size() > 0
            lz := zones.last()
        bool same = not na(lz) and lz.key == aKey
        if not same and time < aKey
            int zLeft = aKey - zPreMin * 60000
            box b = box.new(zLeft, zHiV, time_close, zLoV, xloc = xloc.bar_time, border_color = zColLn, border_width = 1, bgcolor = zCol, text = zShowTxt ? fZoneTxt(aKey, 0) : "", text_size = size.tiny, text_color = zColLn, text_halign = text.align_left, text_valign = text.align_top)
            line l = na
            if zShowPx
                l := line.new(zLeft, close, time_close, close, xloc = xloc.bar_time, color = zColLn, style = line.style_dashed, width = 1)
            zones.push(Zone.new(bx = b, ln = l, key = aKey, top = zHiV, bot = zLoV, endT = aKey + zPostMin * 60000, stopT = aKey + zPostMin * 60000 + zExtH * 3600000))
            while zones.size() > zMax
                Zone old = zones.shift()
                old.bx.delete()
                if not na(old.ln)
                    old.ln.delete()
        else if same and not lz.done
            lz.top := math.max(lz.top, zHiV)
            lz.bot := math.min(lz.bot, zLoV)
            lz.bx.set_top(lz.top)
            lz.bx.set_bottom(lz.bot)
            lz.bx.set_right(time_close)
            if not na(lz.ln)
                lz.ln.set_x2(time_close)
                if time_close <= aKey
                    lz.ln.set_y1(close)
                    lz.ln.set_y2(close)

    // Extender, contar toques y detectar cruce
    for z in zones
        if not z.done and time_close >= z.endT
            z.done := true
            if zExt == "Siempre"
                z.bx.set_extend(extend.right)
                if not na(z.ln)
                    z.ln.set_extend(extend.right)
        else if z.done and z.live
            if barstate.isconfirmed
                bool inZ = high >= z.bot and low <= z.top
                if inZ and not z.inside and z.side != 0
                    z.touches := z.touches + 1
                    if zShowTxt
                        z.bx.set_text(fZoneTxt(z.key, z.touches))
                z.inside := inZ
                if close > z.top
                    if z.side == -1 and zExt == "Hasta que el precio la cruce"
                        z.live := false
                    z.side := 1
                else if close < z.bot
                    if z.side == 1 and zExt == "Hasta que el precio la cruce"
                        z.live := false
                    z.side := -1
            if zExt == "Horas fijas" and time_close >= z.stopT
                z.live := false
            if zExt != "Siempre"
                z.bx.set_right(time_close)
                if not na(z.ln)
                    z.ln.set_x2(time_close)
            if not z.live
                z.bx.set_bgcolor(zColX)
                z.bx.set_border_color(color.new(zColLn, 70))
                if not na(z.ln)
                    z.ln.set_color(color.new(zColLn, 70))

// ═══════════════════════════ TABLAS ═══════════════════════════
var table tHoy = table.new(fPos(posHoyIn), 2, 8, bgcolor = color.new(#131722, 5), frame_color = #434651, frame_width = 1, border_color = #434651, border_width = 1)
var table tHis = table.new(fPos(posHisIn), 7, 5, bgcolor = color.new(#131722, 5), frame_color = #434651, frame_width = 1, border_color = #434651, border_width = 1)

if barstate.islast and showOpen
    color  hdr      = #2a2e39
    color  bg       = color.new(#131722, 5)
    color  fg       = #d1d4dc
    int    cpA      = math.min(cp1, cp2)
    int    cpB      = math.max(cp1, cp2)
    string baseName = str.lower(baseType)

    if showHoy
        string rd = tWin == 0 ? "—" : fReading(tRV, tDir, tHs, needG, hasVol)
        color  rc = tWin == 0 or tDir == 0 or na(tRV) ? color.new(cAmb, 50) : tRV < lowRV ? color.new(cAmb, 30) : tDir > 0 ? color.new(cUp, 30) : color.new(cDn, 30)
        fCell(tHoy, 0, 0, "APERTURA NY " + fHM(0), hdr, color.white)
        fCell(tHoy, 1, 0, tWin > 0 ? str.format_time(tWin, "dd/MM", tzIn) : "—", hdr, color.white)
        fCell(tHoy, 0, 1, "Vela", bg, fg)
        fCell(tHoy, 1, 1, tWin == 0 ? "—" : tDir > 0 ? "▲ alcista" : tDir < 0 ? "▼ bajista" : "◆ sin dirección", bg, tDir > 0 ? cUp : tDir < 0 ? cDn : fg)
        fCell(tHoy, 0, 2, "Volumen", bg, fg)
        fCell(tHoy, 1, 2, not hasVol ? "sin volumen" : na(tVol) ? "—" : str.tostring(tVol, format.volume), bg, fg, not hasVol ? "Este símbolo no trae volumen. Usa CME_MINI:NQ1! o MNQ1!" : "")
        fCell(tHoy, 0, 3, baseType + " " + str.tostring(lookback) + " ses.", bg, fg, "Base: " + baseName + " del volumen de esta misma vela en las sesiones anteriores")
        fCell(tHoy, 1, 3, na(tBase) ? "—" : str.tostring(tBase, format.volume), bg, fg)
        fCell(tHoy, 0, 4, "Diferencia", bg, fg, "Volumen de hoy vs la base, y en desviaciones estándar (σ)")
        fCell(tHoy, 1, 4, na(tRV) ? "—" : (tRV >= 1 ? "+" : "") + str.tostring((tRV - 1) * 100, "0") + "%" + (na(tZ) ? "" : " · " + (tZ >= 0 ? "+" : "") + str.tostring(tZ, "0.0") + "σ"), bg, fg)
        fCell(tHoy, 0, 5, "Percentil", bg, fg, "% de las sesiones anteriores con MENOS volumen que hoy")
        fCell(tHoy, 1, 5, na(tPct) ? "—" : "p" + str.tostring(tPct, "0"), bg, fg)
        fCell(tHoy, 0, 6, "Lectura", bg, fg)
        fCell(tHoy, 1, 6, rd, rc, color.white)
        string nowTxt = "—"
        color  nowCol = bg
        if winS == tWin and time >= tWin + openLen * 60000 and tDir != 0 and tRng > 0
            float mvNow = (close - tRef) * tDir
            bool  sgN   = mvNow > minMove * tRng
            bool  ctN   = not sgN and (tDir > 0 ? close < tLo : close > tHi)
            nowTxt := (sgN ? "SIGUE " : ctN ? "CONTRARIA " : "AMBIGUA ") + fSigned(mvNow / tRng)
            nowCol := sgN ? color.new(RES_OK, 40) : ctN ? color.new(RES_BAD, 40) : color.new(RES_AMB, 50)
        fCell(tHoy, 0, 7, "Ahora", bg, fg, "Dónde está el precio respecto a la vela de apertura de hoy (en múltiplos de su rango)")
        fCell(tHoy, 1, 7, nowTxt, nowCol, color.white)

    if showHis
        fCell(tHis, 0, 0, "Volumen apertura", hdr, color.white, "Sesiones del histórico cargado, agrupadas por el volumen de su vela de apertura")
        fCell(tHis, 1, 0, "N", hdr, color.white, "Sesiones medidas. Con N pequeño los % son ruido.")
        fCell(tHis, 2, 0, "Sigue " + fHM(cpA), hdr, color.white, "% de sesiones con el precio de las " + fHM(cpA) + " más allá del cierre de la vela, a su favor")
        fCell(tHis, 3, 0, "Sigue " + fHM(cpB), hdr, color.white, "% de sesiones con el precio de las " + fHM(cpB) + " más allá del cierre de la vela, a su favor")
        fCell(tHis, 4, 0, "Ambigua " + fHM(cpB), hdr, color.white, "% de sesiones que a las " + fHM(cpB) + " volvieron dentro de la vela sin cruzarla")
        fCell(tHis, 5, 0, "Contraria " + fHM(cpB), hdr, color.white, "% de sesiones con el precio de las " + fHM(cpB) + " al otro lado de la vela")
        fCell(tHis, 6, 0, "Recorrido " + fHM(cpB), hdr, color.white, "Mediana del recorrido desde el cierre de la vela, en múltiplos de su rango")
        array<string> names = array.from("Muy alto (≥+" + str.tostring(strongPc, "0") + "%)", "Sobre la " + baseName, "Bajo la " + baseName)
        array<color>  nCol  = array.from(color.new(#2962ff, 15), color.new(#2962ff, 55), color.new(cAmb, 40))
        int nA  = 0
        int s1A = 0
        int s2A = 0
        int aA  = 0
        int cA  = 0
        array<float> mvA = array.new<float>()
        for i = 0 to 2
            Bucket b = stats.get(i)
            float med = b.mv.size() > 0 ? b.mv.median() : na
            fCell(tHis, 0, 1 + i, names.get(i), nCol.get(i), color.white)
            fCell(tHis, 1, 1 + i, str.tostring(b.n), bg, fg)
            fCell(tHis, 2, 1 + i, fPct(b.sig1, b.n), fPctBg(b.sig1, b.n, true), fg)
            fCell(tHis, 3, 1 + i, fPct(b.sig2, b.n), fPctBg(b.sig2, b.n, true), fg)
            fCell(tHis, 4, 1 + i, fPct(b.amb2, b.n), bg, fg)
            fCell(tHis, 5, 1 + i, fPct(b.con2, b.n), fPctBg(b.con2, b.n, false), fg)
            fCell(tHis, 6, 1 + i, fSigned(med), bg, fg)
            nA  += b.n
            s1A += b.sig1
            s2A += b.sig2
            aA  += b.amb2
            cA  += b.con2
            mvA.concat(b.mv)
        fCell(tHis, 0, 4, "Todas", hdr, color.white, "Base sin filtro: compara cada grupo contra esta fila")
        fCell(tHis, 1, 4, str.tostring(nA), bg, fg)
        fCell(tHis, 2, 4, fPct(s1A, nA), bg, fg)
        fCell(tHis, 3, 4, fPct(s2A, nA), bg, fg)
        fCell(tHis, 4, 4, fPct(aA, nA), bg, fg)
        fCell(tHis, 5, 4, fPct(cA, nA), bg, fg)
        fCell(tHis, 6, 4, fSigned(mvA.size() > 0 ? mvA.median() : na), bg, fg)

# ─── SIGNAL configuration ────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env (it is git-ignored).

# Dashboard access token (long random string). If empty, one is generated on first
# start and printed in the log.
DASHBOARD_TOKEN=

# Port for the dashboard
PORT=8787

# ─── Data ────────────────────────────────────────────────────────────────────────
# Solana RPC — the trade firehose. A free Helius key works well:
#   RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Without a key the public endpoint is used (rate-limited; may drop under load).
RPC_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com

# Feeds to run (rpc = full trade stream, pumpportal = launches/migrations, dexscreener = paid profiles/boosts + USD quotes)
FEEDS=rpc,pumpportal,dexscreener

# Optional PumpPortal API key (paid per message) — streams trades for held coins when no RPC is set.
PUMPPORTAL_API_KEY=

# Record raw market events for replays/research (days kept) and labelled outcomes (days kept)
RECORD=1
RECORD_DAYS=5
SAMPLE_DAYS=30
# Retrain the score every N hours (0 = never)
LEARN_EVERY_HOURS=6
# Wallets remembered for smart-money detection (~0.5 KB each). A heap watchdog also trims
# them automatically if memory runs short, so small (512 MB) instances stay up.
MAX_WALLETS=150000

# ─── Telegram alerts + remote control (optional) ────────────────────────────────────
# 1) talk to @BotFather → /newbot → token   2) message your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Paper trading ─────────────────────────────────────────────────────────────────
PAPER_START_SOL=10

# ─── LIVE trading (real money) — leave disabled until the Learn tab's check passes ─
# Use a NEW wallet made only for the bot, funded with money you can lose.
# LIVE_TRADING=I_UNDERSTAND_THE_RISK
# WALLET_PRIVATE_KEY=            # Phantom → Settings → Manage accounts → Show private key (base58)
# LIVE_MAX_POSITION_SOL=0.05      # hard cap per trade; the dashboard cannot exceed it
# LIVE_MAX_DAILY_LOSS_SOL=0.25    # halts live entries for the day when reached

# ─── Demo ────────────────────────────────────────────────────────────────────────────
# SIM=1 runs a simulated market (fake coins) to try the dashboard without any keys.
# SIM_SPEED=1

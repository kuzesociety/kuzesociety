{
  "name": "signal-engine",
  "version": "2.0.0",
  "description": "SIGNAL: 24/7 pump.fun meme-coin radar, scoring and paper/live trading engine with a mobile dashboard.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
